<div
  class="section-background cms-text-values__background"
  style="background-color: {{ section.settings.background_color }};"
></div>

<section
  class="section page-width-content cms-text-values"
  style="
    --cms-text-values-text-color: {{ section.settings.text_color }};
    --cms-text-values-line-color: {{ section.settings.line_color }};
    --cms-text-values-heading-size: {{ section.settings.heading_size }}px;
    --cms-text-values-subtitle-size: {{ section.settings.subtitle_size }}px;
    --cms-text-values-title-size: {{ section.settings.block_title_size }}px;
    --cms-text-values-body-size: {{ section.settings.block_text_size }}px;
    --cms-text-values-padding-top: {{ section.settings.padding_top }}px;
    --cms-text-values-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cms-text-values__inner">
    <div class="cms-text-values__header">
      {% if section.settings.heading != blank %}
        <h2 class="cms-text-values__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="cms-text-values__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="cms-text-values__divider">
      <span class="cms-text-values__line"></span>

      {% if section.settings.label != blank %}
        <span class="cms-text-values__label">{{ section.settings.label }}</span>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="cms-text-values__grid">
        {% for block in section.blocks %}
          <article class="cms-text-values__item" {{ block.shopify_attributes }}>
            <span class="cms-text-values__number">
              {{ block.settings.number | default: forloop.index }}
            </span>

            <div class="cms-text-values__item-content">
              {% if block.settings.title != blank %}
                <h3 class="cms-text-values__item-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="cms-text-values__item-text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cms-text-values {
    --page-content-width: 1440px;
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));

    color: var(--cms-text-values-text-color);
    padding-block: var(--cms-text-values-padding-top) var(--cms-text-values-padding-bottom);
  }

  .cms-text-values__background {
    width: min(1440px, calc(100% - 32px));
    margin-inline: auto;
  }

  .cms-text-values__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 5vw, 64px);
  }

  .cms-text-values__header {
    display: grid;
    gap: 24px;
  }

  .cms-text-values__heading,
  .cms-text-values__subtitle,
  .cms-text-values__item-title,
  .cms-text-values__item-text {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cms-text-values__heading {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: min(var(--cms-text-values-heading-size), 38px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .cms-text-values__subtitle {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: min(var(--cms-text-values-subtitle-size), 22px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.45;
  }

  .cms-text-values__divider {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cms-text-values__line {
    display: block;
    width: 100%;
    border-top: 1px solid var(--cms-text-values-line-color);
    opacity: 0.36;
  }

  .cms-text-values__label {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: 14px;
    letter-spacing: 0;
    line-height: 1.2;
    opacity: 0.72;
  }

  .cms-text-values__grid {
    display: grid;
    gap: 44px;
  }

  .cms-text-values__item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .cms-text-values__number {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: 24px;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .cms-text-values__item-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .cms-text-values__item-title {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: min(var(--cms-text-values-title-size), 28px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.24;
  }

  .cms-text-values__item-text {
    color: inherit;
    font-family: var(--font-primary--family);
    font-size: min(var(--cms-text-values-body-size), 18px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.38;
    opacity: 0.92;
  }

  @media screen and (max-width: 749px) {
    .cms-text-values__header {
      text-align: center;
    }
  }

  @media screen and (min-width: 750px) {
    .cms-text-values__background {
      width: min(1440px, calc(100% - 80px));
    }

    .cms-text-values__header {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .cms-text-values__heading {
      font-size: var(--cms-text-values-heading-size);
      max-width: 11em;
    }

    .cms-text-values__subtitle {
      font-size: var(--cms-text-values-subtitle-size);
      max-width: 34rem;
    }

    .cms-text-values__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(48px, 7vw, 100px);
    }

    .cms-text-values__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .cms-text-values__item-title {
      font-size: var(--cms-text-values-title-size);
      max-width: 12em;
    }

    .cms-text-values__item-text {
      font-size: var(--cms-text-values-body-size);
      max-width: 26rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CMS text values",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bezpieczeństwo dzieci to komfort rodziców"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Każdy produkt powstaje z myślą o realnych potrzebach rodzin. Przechodzi rygorystyczne testy i spełnia europejskie normy - by dać Ci pewność i spokój."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Divider label",
      "default": "nasze wartości"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ff431c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff6ee"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#fff6ee"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "block_title_size",
      "label": "Block title size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "block_text_size",
      "label": "Block text size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bezpieczeństwo bez kompromisów"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Każdy fotelik przechodzi rygorystyczne testy zderzeniowe. Współpracujemy z czołowymi instytutami badawczymi w Europie, by spełniać normy zanim staną się standardem."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CMS text values",
      "blocks": [
        {
          "type": "value"
        },
        {
          "type": "value",
          "settings": {
            "number": "02"
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "03"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign block_settings = block.settings
  assign current_product = closest.product | default: product
  assign related_products = current_product.metafields['shopify--discovery--product_recommendation']['related_products'].value
-%}

{%- if related_products != blank -%}
  <div
    class="related-products-list spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      --related-products-list-columns: repeat({{ block_settings.columns }}, minmax(0, 1fr));
      --related-products-list-mobile-columns: repeat({{ block_settings.mobile_columns }}, minmax(0, 1fr));
      --related-products-list-gap: {{ block_settings.gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <h2 class="related-products-list__heading h5">{{ block_settings.heading }}</h2>
    {%- endif -%}

    <ul class="related-products-list__items" role="list">
      {%- assign rendered_products = 0 -%}

      {%- for related_product in related_products -%}
        {%- if related_product.available and rendered_products < block_settings.max_products -%}
          {%- assign image_alt = related_product.featured_image.alt | default: related_product.title -%}
          <li class="related-products-list__item">
            <a class="related-products-list__link" href="{{ related_product.url }}">
              <span class="related-products-list__media" style="--related-products-list-image-ratio: {{ block_settings.image_ratio }};">
                {%- if related_product.featured_image != blank -%}
                  {{
                    related_product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '180, 240, 360, 480, 600',
                      sizes: '(min-width: 990px) 16vw, (min-width: 750px) 25vw, 50vw',
                      alt: image_alt
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'related-products-list__placeholder' }}
                {%- endif -%}
              </span>

              <span class="related-products-list__content">
                <span class="related-products-list__title">{{ related_product.title }}</span>
                <span class="related-products-list__price">
                  {% render 'price',
                    product_resource: related_product,
                    show_sale_price_first: block_settings.show_sale_price_first
                  %}
                </span>
              </span>
            </a>
          </li>
          {%- assign rendered_products = rendered_products | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for related_product in related_products -%}
        {%- if related_product.available == false and rendered_products < block_settings.max_products -%}
          {%- assign image_alt = related_product.featured_image.alt | default: related_product.title -%}
          <li class="related-products-list__item related-products-list__item--unavailable">
            <a class="related-products-list__link" href="{{ related_product.url }}">
              <span class="related-products-list__media" style="--related-products-list-image-ratio: {{ block_settings.image_ratio }};">
                {%- if related_product.featured_image != blank -%}
                  {{
                    related_product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '180, 240, 360, 480, 600',
                      sizes: '(min-width: 990px) 16vw, (min-width: 750px) 25vw, 50vw',
                      alt: image_alt
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'related-products-list__placeholder' }}
                {%- endif -%}
              </span>

              <span class="related-products-list__content">
                <span class="related-products-list__title">{{ related_product.title }}</span>
                <span class="related-products-list__price">
                  {% render 'price',
                    product_resource: related_product,
                    show_sale_price_first: block_settings.show_sale_price_first
                  %}
                </span>
              </span>
            </a>
          </li>
          {%- assign rendered_products = rendered_products | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .related-products-list {
    width: 100%;
  }

  .related-products-list__heading {
    margin: 0 0 var(--padding-sm);
  }

  .related-products-list__items {
    display: grid;
    grid-template-columns: var(--related-products-list-mobile-columns);
    column-gap: var(--related-products-list-gap);
    row-gap: calc(var(--related-products-list-gap) * 1.5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-products-list__link {
    display: flex;
    flex-direction: column;
    gap: var(--padding-xs);
    color: inherit;
    text-decoration: none;
  }

  .related-products-list__link:hover .related-products-list__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .related-products-list__media {
    display: block;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--related-products-list-image-ratio);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .related-products-list__media img,
  .related-products-list__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-products-list__content {
    display: grid;
    gap: var(--padding-3xs);
    min-width: 0;
  }

  .related-products-list__title {
    overflow-wrap: anywhere;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .related-products-list__price {
    font-size: 0.9rem;
  }

  .related-products-list__item--unavailable {
    opacity: 0.58;
  }

  .related-products-list__item--unavailable .related-products-list__media {
    filter: grayscale(1);
  }

  @media screen and (min-width: 750px) {
    .related-products-list__items {
      grid-template-columns: var(--related-products-list-columns);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products list",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Produkty powiązane"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_sale_price_first",
      "label": "Show sale price first",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Related products list"
    }
  ]
}
{% endschema %}
